{
  "name": "@crm/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:sites": "node -e \"require('node:fs').rmSync('dist/server/index.js', { force: true })\" && pnpm run build && esbuild worker/sites-spa.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/server/index.js",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler pages deploy dist/client",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "echo 'No tests configured for web yet'"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.90.0",
    "@tanstack/react-start": "^1.0.0",
    "chrono-node": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.13",
    "lucide-react": "^1.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.118.0"
  }
}
