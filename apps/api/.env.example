# Backend environment template
#
# For local development with Wrangler:
#   Copy to .dev.vars (not .env) — Wrangler reads .dev.vars
#   Fill in your Neon connection string and auth secret
#
# For Cloudflare Workers (production/preview):
#   Set via `wrangler secret put DATABASE_URL --env production`
#   Set via `wrangler secret put AUTH_SECRET --env production`
#   These are stored encrypted in Cloudflare — never in code.

# Neon database connection string (postgresql://...)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Auth secret — API key or JWT signing secret
AUTH_SECRET=change-me-to-a-random-string
