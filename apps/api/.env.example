# Backend environment template
#
# For local development with Wrangler:
#   Copy to .dev.vars (not .env) — Wrangler reads .dev.vars
#   Fill in your Neon connection string and auth secret
#
# For Cloudflare Workers (production/preview):
#   Set via `wrangler secret put DATABASE_URL --env production`
#   Set via `wrangler secret put AUTH_SECRET --env production`
#   These are stored encrypted in Cloudflare — never in code.

# Neon database connection string (postgresql://...)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Existing app auth secret
AUTH_SECRET=change-me-to-a-random-string

# Google OAuth web client
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# OAuth token encryption and session hashing
ENCRYPTION_KEY=your-32-byte-base64-encryption-key
SESSION_SECRET=your-high-entropy-session-secret

# Credentialed browser requests must use an explicit origin
CORS_ORIGIN=http://localhost:3001
