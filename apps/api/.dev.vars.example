# Backend local secrets — copy to .dev.vars and fill in real values.
# .dev.vars is gitignored. Do NOT commit real credentials.

# Neon database connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Auth secret (API key or JWT secret)
AUTH_SECRET=dev-secret-change-me

# Web Push (VAPID) keys — generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:push@ember.app
