{
  "name": "crm-sccci",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "dev:web": "pnpm --filter @crm/web dev",
    "dev:api": "pnpm --filter @crm/api dev",
    "build:web": "pnpm --filter @crm/web build",
    "build:api": "pnpm --filter @crm/api build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @crm/api db:generate",
    "db:migrate": "pnpm --filter @crm/api db:migrate",
    "db:push": "pnpm --filter @crm/api db:push",
    "deploy:api": "pnpm --filter @crm/api deploy",
    "deploy:web": "pnpm --filter @crm/web deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.19.0"
  }
}
